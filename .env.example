# LM Studio connection
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
DEFAULT_MODEL=local-model
LM_STUDIO_TIMEOUT=120.0
MAX_RETRIES=3

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Security
SECRET_KEY=change-me-to-something-random-in-production
ENABLE_SANDBOX=true

# Tools
WORKSPACE_DIR=./workspace
COMMAND_TIMEOUT=30
MAX_FILE_SIZE_MB=10

# Web search
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=10

# Memory
MEMORY_DIR=./data/memory

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/platform.log

# VS Code
VSCODE_EXECUTABLE=code
